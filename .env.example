# Local development only. Never commit your real .env file.
SECRET_KEY=replace-with-a-random-secret-generated-for-your-environment
APP_ENV=development
FLASK_DEBUG=false
DATABASE_URL=sqlite:///donation.db
UPLOAD_FOLDER=static/uploads

# Initial admin creation only; set these in a secure shell, not in source control.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Render production settings are configured in the Render Dashboard:
# APP_ENV=production
# SECRET_KEY=<random 64+ character value>
# DATABASE_URL=<Render Postgres INTERNAL URL>
# UPLOAD_FOLDER=/var/data/uploads
